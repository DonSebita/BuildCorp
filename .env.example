# Copiar a .env y completar. No subir .env al repositorio.
DEBUG=False
SECRET_KEY=cambia-esta-clave-por-una-larga-y-aleatoria
# PostgreSQL local de la EC2 (o de tu PC en desarrollo)
DATABASE_URL=postgres://buildcorp:CLAVE_DB@localhost:5432/buildcorp
# IP pública o DNS de la EC2, separados por coma
ALLOWED_HOSTS=localhost,127.0.0.1,IP_PUBLICA_EC2
CSRF_TRUSTED_ORIGINS=http://IP_PUBLICA_EC2
# URL que se imprime en los QR (vacío = la del navegador)
SITE_URL=
# Botón «?» en el login con usuarios y contraseña de la demo (False para ocultarlo)
MOSTRAR_CREDENCIALES_DEMO=True
